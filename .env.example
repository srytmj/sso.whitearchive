APP_NAME="SSO Engine"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://sso.suryatmaja.dev
ASSET_URL=http://sso.suryatmaja.dev

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_READ_HOST=127.0.0.1
DB_WRITE_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_sso
DB_USERNAME=root
DB_PASSWORD=

# Hanya dipakai oleh docker/compose.prod.yml / docker/compose.standalone.yml (bukan dev) —
# root password MySQL container, terpisah dari DB_PASSWORD (dipakai DB_USERNAME non-root)
DB_ROOT_PASSWORD=

# Hanya dipakai oleh docker/compose.standalone.yml — alamat yang di-serve Caddy.
# Testing/pakai lokal: biarkan default (http://localhost).
# Deploy publik: isi domain asli tanpa skema, mis. "sso.whitearchive.id" — Caddy otomatis
# provision HTTPS via Let's Encrypt, tidak perlu setup manual.
# PENTING: jangan taruh port di sini (mis. "http://localhost:8080") kalau HTTP_PORT
# diganti dari default — atur port host lewat HTTP_PORT/HTTPS_PORT saja di bawah.
CADDY_SITE_ADDRESS=http://localhost
HTTP_PORT=80
HTTPS_PORT=443

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=resend
MAIL_FROM_ADDRESS="noreply@suryatmaja.dev"
MAIL_FROM_NAME="SSO whitearchive.id"

RESEND_API_KEY=re_***

VITE_APP_NAME="${APP_NAME}"

ADMIN_EMAIL=admin@suryatmaja.dev
ADMIN_PASSWORD=change-me-in-production

# Deploy via SSH dari lokal (untuk make remote-deploy / make remote-update)
SERVER_HOST=
SSH_KEY_PATH=~/.ssh/your-key.pem
SERVER_USER=ubuntu
SERVER_PATH=/var/www/sso
